# Viva La Vida — env.example (template; copy to .env and fill in real values)
#
# Render will inject the real values from its dashboard. Never commit .env.

# REQUIRED
# Django secret key. Use a strong random value in production.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-in-production

# Hostnames your app serves. Render sets this automatically, but you can
# override it here for local development.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Origins allowed to POST (needed behind an HTTPS proxy / Render).
DJANGO_CSRF_TRUSTED_ORIGINS=https://viva-la-vida-1.onrender.com

# Database (PostgreSQL on Render; leave empty for SQLite local dev)
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
# DJANGO_DATABASE_URL=postgres://...

# Optional production security toggles (set DJANGO_SECURE=true behind HTTPS)
# DJANGO_SECURE=true

# Optional: path to the trained ISL recogniser.
# RECOGNITION_MODEL_PATH=/app/staticfiles/recognition/model.pkl
